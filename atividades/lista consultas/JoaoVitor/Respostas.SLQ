-- 1 Municípios que não pertencem a região norte

SELECT m.*
FROM municipio m
JOIN estado e ON m.CodEstado = e.CodEstado
JOIN regiao r ON e.CodRegiao = r.CodRegiao
WHERE r.NomeRegiao <> 'Norte';

-- 2 Municípios que possuem o mesmo nome

SELECT NomeMunicipio
FROM municipio
GROUP BY NomeMunicipio
HAVING COUNT(*) > 1;

-- 3 Média de municípios por Região e por Estado

SELECT 
  r.NomeRegiao,
  COUNT(m.CodMunicipio) / COUNT(DISTINCT e.CodEstado) AS MediaMunicipiosPorEstado
FROM regiao r
JOIN estado e ON r.CodRegiao = e.CodRegiao
JOIN municipio m ON e.CodEstado = m.CodEstado
GROUP BY r.NomeRegiao;

-- 4 Município com as pessoas mais idosas

SELECT m.CodMunicipio, m.NomeMunicipio, i.Ano, i.IDH_Longevidade
FROM municipio m
JOIN indice i ON m.CodMunicipio = i.CodMunicipio
WHERE i.IDH_Longevidade = (
    SELECT MAX(IDH_Longevidade)
    FROM indice
);

-- 5 Ano em que Salvador obteve o melhor índice de Instrução

SELECT i.Ano, i.IDH_Educacao
FROM municipio m
JOIN indice i ON m.CodMunicipio = i.CodMunicipio
WHERE m.NomeMunicipio = 'Salvador'
ORDER BY i.IDH_Educacao DESC
LIMIT 1;

-- 6 Qual o município com a melhor distribuição de renda

SELECT m.NomeMunicipio, i.Ano, i.IDH_Renda
FROM municipio m
JOIN indice i ON m.CodMunicipio = i.CodMunicipio
ORDER BY i.IDH_Renda DESC
LIMIT 1;


-- 7 Quais estados possuem municípios com IDH geral maior que 0,8

SELECT DISTINCT e.NomeEstado
FROM estado e
JOIN municipio m ON e.CodEstado = m.CodEstado
JOIN indice i ON m.CodMunicipio = i.CodMunicipio
WHERE i.IDH_Geral > 0.8;

-- 8 Qual o maior IDH de educação por estado

SELECT e.NomeEstado, MAX(i.IDH_Educacao) AS Maior_IDH_Educacao
FROM estado e
JOIN municipio m ON e.CodEstado = m.CodEstado
JOIN indice i ON m.CodMunicipio = i.CodMunicipio
GROUP BY e.NomeEstado;

-- 9 Relatório de Todos IDHs da Bahia de 91 e 2000, inclusive com a
diferença entre os mesmos

SELECT 
    m.NomeMunicipio, 
    i1.Ano AS Ano_1991, 
    i1.IDH_Geral AS IDH_Geral_1991, 
    i1.IDH_Renda AS IDH_Renda_1991, 
    i1.IDH_Longevidade AS IDH_Longevidade_1991, 
    i1.IDH_Educacao AS IDH_Educacao_1991,
    i2.Ano AS Ano_2000, 
    i2.IDH_Geral AS IDH_Geral_2000, 
    i2.IDH_Renda AS IDH_Renda_2000, 
    i2.IDH_Longevidade AS IDH_Longevidade_2000, 
    i2.IDH_Educacao AS IDH_Educacao_2000,
    (i2.IDH_Geral - i1.IDH_Geral) AS Diferenca_IDH_Geral,
    (i2.IDH_Renda - i1.IDH_Renda) AS Diferenca_IDH_Renda,
    (i2.IDH_Longevidade - i1.IDH_Longevidade) AS Diferenca_IDH_Longevidade,
    (i2.IDH_Educacao - i1.IDH_Educacao) AS Diferenca_IDH_Educacao
FROM municipio m
JOIN indice i1 ON m.CodMunicipio = i1.CodMunicipio AND i1.Ano = 1991
JOIN indice i2 ON m.CodMunicipio = i2.CodMunicipio AND i2.Ano = 2000
JOIN estado e ON m.CodEstado = e.CodEstado
WHERE e.NomeEstado = 'Bahia'
ORDER BY m.NomeMunicipio;


-- 10 Relatório comparativo entre as médias dos IDHs de MG e BA, de 2000 e 91

SELECT 
    e.NomeEstado,
    i.Ano,
    AVG(i.IDH_Geral) AS Media_IDH_Geral,
    AVG(i.IDH_Renda) AS Media_IDH_Renda,
    AVG(i.IDH_Longevidade) AS Media_IDH_Longevidade,
    AVG(i.IDH_Educacao) AS Media_IDH_Educacao
FROM estado e
JOIN municipio m ON e.CodEstado = m.CodEstado
JOIN indice i ON m.CodMunicipio = i.CodMunicipio
WHERE (e.NomeEstado IN ('Minas Gerais', 'Bahia'))
  AND (i.Ano IN (1991, 2000))
GROUP BY e.NomeEstado, i.Ano
ORDER BY e.NomeEstado, i.Ano;
