						-- Criação de Banco
create database blog;
						-- Usa banco
use blog;
						-- Criação de tabela 
create table Autor(
id_autor int AUTO_INCREMENT primary key,
nome varchar(100),
usuario_autor varchar(8),
senha_autor varchar(100)
);

create table Postagens(
id_postagens int AUTO_INCREMENT primary key,
titulo varchar(100),
texto varchar(100),
id_autor int,
foreign key (id_autor) references Autor(id_autor)
);

create table Visitantes(
id_visitantes int AUTO_INCREMENT primary key,
nome_visitantes varchar(100),
email varchar(100)
);

create table Comentarios(
id_comentarios int AUTO_INCREMENT primary key,
id_visitantes int,
id_postagens int,
foreign key (id_visitantes) references Visitantes(id_visitantes),
foreign key (id_postagens) references Postagens(id_postagens),
texto varchar(10000),
nota int,
aprovado BOOLEAN 
);

